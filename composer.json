{
  "name": "nextcloud/nextcloud-theme",
  "description": "Nextcloud wordpress theme",
  "license": "AGPL",
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "platform": {
      "php": "8.4.3"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "geoip2/geoip2": "^2.13",
    "predis/predis": "^1.1.10",
    "daveearley/daves-email-validation-tool": "^1.2",
    "endroid/qr-code": "^6.1",
    "phpxmlrpc/polyfill-xmlrpc": "^1.0"
  },
  "scripts": {
    "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm",
    "psalm:fix": "psalm --alter --issues=InvalidReturnType,InvalidNullableReturnType,MissingParamType,InvalidFalsableReturnType",
    "psalm:update-baseline": "psalm --threads=1 --update-baseline",
    "update-data-files": [
      "cd vendor/daveearley/daves-email-validation-tool/scripts && php update-disposable-email-providers.php && php update-top-level-domains.php"
    ],
    "post-install-cmd": "@update-data-files"
  },
  "require-dev": {
    "nextcloud/coding-standard": "^1.5.0",
    "php-stubs/wordpress-stubs": "^7.1.2",
    "mockery/mockery": "^1.6.15",
    "phpunit/phpunit": "^9.6.38",
    "vimeo/psalm": "^6.20"
  },
  "autoload": {
    "psr-4": {
      "EmailValidation\\": "emailValidator/src/",
      "EmailValidation\\Tests\\": "emailValidator/tests"
    }
  }
}
